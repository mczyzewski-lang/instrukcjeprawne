# Adres publiczny serwisu (canonical, sitemap, OG, kod QR w PDF)
NEXT_PUBLIC_SITE_URL=https://instrukcjeprawne.pl

# Dane operatora do polityki prywatności
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Treści „do zatwierdzenia” (przygotowane z pomocą AI) widoczne publicznie z oznaczeniem i noindex.
# Przed startem produkcyjnym ustaw false i zatwierdź treści w panelu.
PUBLIC_SHOW_UNREVIEWED=true

# Panel redakcyjny (/admin). W produkcji bez hasła panel jest wyłączony.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=  # min. 32 losowe znaki

# Baza SQLite i pliki (domyślnie ./data)
DATA_DIR=
DATABASE_PATH=

# Sól do haszowania kluczy limitów (np. IP) – nie przechowujemy adresów IP
HASH_SALT=

# Generator ilustracji (opcjonalny). Bez klucza strona używa biblioteki SVG.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium

# Kierowanie zgłoszeń do partnerów – wyłącznie HTTPS. Brak = zgłoszenie zapisane tylko w bazie.
LEAD_WEBHOOK_SECRET=            # podpis HMAC SHA-256 w nagłówku x-ip-signature
LEAD_WEBHOOK_PRAVNA_UPADLOSC=
LEAD_WEBHOOK_PRAVNA_RESTRUKTURYZACJA=
LEAD_WEBHOOK_PRAVNA_ZNAKI=
LEAD_WEBHOOK_PRAVNA_IPBOX=
LEAD_WEBHOOK_NOWY_ETAP=
LEAD_WEBHOOK_SKD=

# Czat z ekspertem – powiadomienia SMS o odpowiedzi (bramka dostawcy SMS). Brak = SMS nieskonfigurowane.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_AFTER_MINUTES=5
